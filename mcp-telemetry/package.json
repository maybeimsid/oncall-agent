{
  "name": "mcp-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only telemetry tools for the on-call agent, served over MCP stdio",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "start": "node dist/src/index.js",
    "record-fixtures": "tsc -p tsconfig.build.json && node dist/scripts/record-fixtures.js",
    "record-trace-fixtures": "tsc -p tsconfig.build.json && node dist/scripts/record-trace-fixtures.js",
    "record-latency-fixtures": "tsc -p tsconfig.build.json && node dist/scripts/record-latency-fixtures.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
